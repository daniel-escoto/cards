{
  "name": "cards",
  "version": "1.0.0",
  "description": "holdem.nyc — private-room multiplayer Texas Hold'em.",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node tests/run-all.js",
    "test:betting": "node tests/betting.js",
    "test:blinds": "node tests/blinds.js",
    "test:bots": "node tests/bots.js",
    "test:money-ledger": "node tests/money-ledger.js",
    "test:money-join": "node tests/money-join.js",
    "test:raise-presets": "node tests/raise-presets.js",
    "test:seated-players": "node tests/seated-players.js",
    "test:side-pots-cashin": "node tests/side-pots-cashin.js",
    "test:showdown-reveal": "node tests/showdown-reveal.js",
    "test:all-in-presets": "node tests/all-in-presets.js",
    "test:check-bet-merge": "node tests/check-bet-merge.js",
    "test:call-raise-merge": "node tests/call-raise-merge.js",
    "test:frontend": "node tests/card-art.js && node tests/keyboard.js && node tests/display-name.js && node tests/invite-url.js",
    "test:invite-url": "node tests/invite-url.js",
    "test:engine-offline": "node tests/engine-offline.js",
    "test:offline-handoff": "node tests/offline-handoff.js",
    "test:turn-timer": "node tests/turn-timer.js",
    "test:blind-chips": "node tests/blind-chips.js",
    "test:turn-clock-warning": "node tests/turn-clock-warning.js",
    "test:shot-clock-tick": "node tests/shot-clock-tick.js",
    "test:ready-timer": "node tests/ready-timer.js",
    "test:ready-clock": "node tests/ready-clock.js",
    "test:spectator": "node tests/spectator.js",
    "test:graceful-deploy": "node tests/graceful-deploy.js",
    "test:redis-deploy": "node tests/redis-deploy.js",
    "smoke": "node tests/smoke.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "nanoid": "^5.1.11",
    "pokersolver": "^2.1.4",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
